# ==============================================================================
# AI Token Monitor - Environment & Port Configuration
# ==============================================================================

# Backend Real-Time Bridge Server Port (Default: 3001)
PORT=3001

# Frontend Dashboard Web Port (Default: 5173)
VITE_PORT=5173

# Frontend API URL (Leave blank to use default proxy / localhost)
VITE_API_URL=http://localhost:3001

# Host & Environment
HOST=localhost
NODE_ENV=development

# Optional Cloud API Keys (for remote cloud usage sync if enabled)
# Note: Local log parsing (Codex, Claude, Antigravity) does NOT require API keys.
OPENAI_API_KEY=sk-dummy-openai-key-replace-with-yours
ANTHROPIC_API_KEY=sk-ant-dummy-anthropic-key-replace-with-yours
GEMINI_API_KEY=AIzaSyDummyGeminiKeyReplaceWithYours

# Budget & Quota Alerting (in USD)
MONTHLY_BUDGET_USD=50.00
DAILY_BUDGET_USD=5.00
ALERT_THRESHOLD_PERCENT=80

# Currency Conversion Settings
EXCHANGE_RATE_THB=35.50

# Log Watcher Paths (Leave blank to use default OS user home directories)
# CODEX_LOG_DIR=
# CLAUDE_LOG_DIR=
# ANTIGRAVITY_LOG_DIR=
